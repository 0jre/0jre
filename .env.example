# Backend-only secrets; never include these in EXPO_PUBLIC_* variables.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
JUPITER_API_KEY=
# Optional: comma-separated Privy client IDs; set explicitly in production.
PRIVY_ALLOWED_CLIENT_IDS=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HYPERLIQUID_TESTNET=true
# Explicit deployment switch. Keep false until configured and reviewed.
LIVE_EXECUTION_ENABLED=false
DATABASE_PATH=./data/orbit.sqlite
PORT=8081
CORS_ORIGINS=
STATIC_DIR=apps/mobile/dist

# Public mobile/web configuration. Never put app secret or Jupiter key here.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Web can use same origin. Native requires an externally reachable HTTPS API.
EXPO_PUBLIC_API_URL=
